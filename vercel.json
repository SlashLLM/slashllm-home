{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.slashllm.com" }], "destination": "https://slashllm.com/:path*", "permanent": true },
    { "source": "/Services.html", "destination": "/services", "permanent": true },
    { "source": "/Industries.html", "destination": "/industries", "permanent": true },
    { "source": "/Products.html", "destination": "/products", "permanent": true },
    { "source": "/Solutions.html", "destination": "/solutions", "permanent": true },
    { "source": "/About.html", "destination": "/about", "permanent": true },
    { "source": "/CaseStudies.html", "destination": "/case-studies", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
